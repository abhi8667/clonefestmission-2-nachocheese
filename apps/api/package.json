{
  "name": "@triarc/api",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "benchmark": "tsx src/scripts/benchmark.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test --test-concurrency=1 test/api.test.ts test/security.test.ts"
  },
  "dependencies": {
    "@triarc/engine": "*",
    "@triarc/shared-types": "*",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
